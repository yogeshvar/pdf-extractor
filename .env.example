# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Any vision-capable model on OpenRouter works. Good cheap default:
OPENROUTER_MODEL=google/gemini-2.5-flash

# Where the SQLite job store lives (mount a volume here when hosting)
DATA_DIR=./data

# HTTP Basic Auth (required for public deployments)
ACCESS_USERNAME=demo
ACCESS_PASSWORD=change-me-to-a-strong-password

# Set to true to skip auth locally only — never use on Railway/production
# DISABLE_AUTH=true
